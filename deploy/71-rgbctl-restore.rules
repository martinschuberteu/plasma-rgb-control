# rgbctl: set the lighting again when a device comes back (KVM switch, replug, wake).
# Starts the systemd user service rgbctl-restore@<device id>.service for the logged-in user
# (installed by install.sh). Install: sudo install -m 644 deploy/71-rgbctl-restore.rules /etc/udev/rules.d/
# Same nodes as 70-rgbctl-logitech.rules: the G815's HID++ interface and the receiver's.
SUBSYSTEM=="hidraw", ATTR{device/modalias}=="hid:b0003g*v0000046Dp0000C33F", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="rgbctl-restore@g815.service"
SUBSYSTEM=="hidraw", ATTR{device/modalias}=="hid:b0003g*v0000046Dp0000C53A", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="rgbctl-restore@gpro.service"
